# SelTok Lens - Environment Variables
# Copy this to .env and fill in your values

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=1HkBdu_F9CMo-ZOAXA2fi7DQa7cPvIm6W
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account.json

# Facebook (SelTok Lens page)
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Instagram (connected to SelTok Lens Facebook page)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# Threads
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# YouTube (optional)
YT_CLIENT_ID=your_youtube_client_id
YT_CLIENT_SECRET=your_youtube_client_secret
YT_REFRESH_TOKEN=your_youtube_refresh_token

# AI Caption Generation
POLLINATIONS_API_KEY=your_pollinations_api_key
AI_MODEL=openai

# Twitter/X (optional)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=your_telegram_channel_id

# VK (optional)
VK_ACCESS_TOKEN=your_vk_access_token
VK_GROUP_ID=your_vk_group_id
